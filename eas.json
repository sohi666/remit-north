{
  "cli": {
    "version": ">= 27.4.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "$ASC_API_KEY_PATH",
        "ascApiKeyIssuerId": "$ASC_ISSUER_ID",
        "ascApiKeyId": "$ASC_KEY_ID"
      },
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_SERVICE_ACCOUNT_KEY_PATH",
        "track": "production",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      }
    },
    "production-draft": {
      "extends": "production",
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    },
    "internal": {
      "extends": "production",
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "internal-draft": {
      "extends": "production",
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
